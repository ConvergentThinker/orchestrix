<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cucumber BDD Test Suite" parallel="methods" thread-count="3" verbose="1"
       data-provider-thread-count="3">
    
    <!-- Cucumber Test Runner: scenarios run in parallel via DataProvider -->
    <test name="Cucumber BDD Tests">
        <classes>
            <class name="com.parallel.appium.runners.CucumberTestRunner"/>
        </classes>
    </test>
    
    <!-- You can also run traditional TestNG tests alongside Cucumber -->
    <!--
    <test name="Traditional TestNG Tests">
        <parameter name="device-tier" value="premium"/>
